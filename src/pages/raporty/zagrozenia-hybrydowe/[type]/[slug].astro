---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { findReport, reportUrl, reportsByKind, type ReportKind } from '../../../../lib/reports';
import { renderMarkdown } from '../../../../lib/markdown';
export async function getStaticPaths() {
  const kinds = { tygodniowe: 'weekly', miesieczne: 'monthly', roczne: 'annual' } as const;
  const paths = [];
  for (const [route, kind] of Object.entries(kinds) as [keyof typeof kinds, ReportKind][]) {
    for (const report of reportsByKind(kind)) {
      paths.push({ params: { type: route, slug: report.slug } });
    }
  }
  return paths;
}
const kinds = { tygodniowe: 'weekly', miesieczne: 'monthly', roczne: 'annual' } as const;
const kind = kinds[Astro.params.type as keyof typeof kinds]; const entry = kind && findReport(kind, Astro.params.slug!); if (!entry) return new Response(null, { status: 404 });
const related = reportsByKind(entry.kind); const position = related.findIndex((report) => report.id === entry.id); const newer = related[position - 1]; const older = related[position + 1];
---
<BaseLayout title={entry.title}><div class="report-content" set:html={renderMarkdown(entry.body)} /><p><a href="/raporty/zagrozenia-hybrydowe/metodologia">Metodologia ocen</a></p><nav class="report-navigation" aria-label="Nawigacja raportu"><span class="breadcrumbs"><a href="/raporty">Raporty</a><span aria-hidden="true">/</span><a href="/raporty/zagrozenia-hybrydowe">Monitoring zagrożeń hybrydowych Rosji</a></span><span class="report-links">{newer ? <a href={reportUrl(newer)}>&larr; Nowszy</a> : null}{older ? <a href={reportUrl(older)}>Starszy &rarr;</a> : null}</span></nav></BaseLayout>
<style>.report-navigation{position:sticky;z-index:10;bottom:.75rem;display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin:1.5rem 0 .75rem;padding:.45rem .6rem;border:1px solid #b8afd0;background:#f6f3faeF;box-shadow:0 .25rem 1rem #21174f22;backdrop-filter:blur(8px);font-size:.82rem}.breadcrumbs,.report-links{display:flex;align-items:center;gap:.45rem}.report-links{gap:.35rem}.report-links a{border:1px solid #b8afd0;padding:.25rem .45rem;text-decoration:none;font-size:.78rem;line-height:1.2}@media(max-width:42rem){.report-navigation{align-items:flex-start;flex-direction:column}.breadcrumbs{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}}</style>
