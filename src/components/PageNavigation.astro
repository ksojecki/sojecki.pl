---
type Item = { href?: string; label: string };
const { items, actions = [] } = Astro.props as { items: Item[]; actions?: Item[] };
---
<nav class="page-navigation" data-page-navigation aria-label="Nawigacja strony"><span class="page-navigation__crumbs">{items.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</>)}</span>{actions.length > 0 && <span class="page-navigation__actions">{actions.map((action) => <a href={action.href}>{action.label}</a>)}</span>}</nav>
<style>.page-navigation{position:relative;z-index:10;display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin:2rem 0 0;padding:.45rem .6rem;border:1px solid #b8afd0;background:#f6f3faef;font-size:.82rem;transition:box-shadow .18s ease,transform .18s ease}.page-navigation.is-scrolled{position:fixed;right:1.25rem;bottom:.75rem;left:1.25rem;width:auto;margin:0;box-shadow:0 .25rem 1rem #21174f22}.page-navigation__crumbs,.page-navigation__actions{display:flex;align-items:center;gap:.45rem;min-width:0}.page-navigation__actions{gap:.35rem}.page-navigation__actions a{border:1px solid #b8afd0;padding:.25rem .45rem;text-decoration:none;font-size:.78rem;line-height:1.2}@media(min-width:74.5rem){.page-navigation.is-scrolled{right:max(1.25rem,calc((100vw - 72rem)/2));left:max(1.25rem,calc((100vw - 72rem)/2))}}@media(max-width:42rem){.page-navigation{align-items:flex-start;flex-direction:column}.page-navigation__crumbs{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}}</style>
<script>const navigation = document.querySelector<HTMLElement>('[data-page-navigation]'); const updateNavigation = () => navigation?.classList.toggle('is-scrolled', window.scrollY > 0); updateNavigation(); addEventListener('scroll', updateNavigation, { passive: true });</script>
