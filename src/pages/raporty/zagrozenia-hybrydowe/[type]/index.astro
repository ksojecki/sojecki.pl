---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { confrontationEmoji, kindLabel, reportUrl, reportsByKind } from '../../../../lib/reports';
export function getStaticPaths() {
  return [{ params: { type: 'tygodniowe' } }, { params: { type: 'miesieczne' } }, { params: { type: 'roczne' } }];
}
const routes = { tygodniowe: 'weekly', miesieczne: 'monthly', roczne: 'annual' } as const;
const kind = routes[Astro.params.type as keyof typeof routes];
if (!kind) return new Response(null, { status: 404 });
const reports = reportsByKind(kind);
---
<BaseLayout title={`${kindLabel[kind]} raporty`}><p><a href="/raporty/zagrozenia-hybrydowe">&larr; Monitoring zagrożeń hybrydowych Rosji</a></p><h1>{kindLabel[kind]}</h1><p>Raporty w kolejności od najnowszego.</p><ol class="reports">{reports.map((report) => <li><a href={reportUrl(report)}><strong>{report.title}</strong><span>{report.intensity === null ? 'n/d' : `${report.intensity}/10`} · {confrontationEmoji(report.confrontation)}</span></a></li>)}</ol></BaseLayout>
<style>.reports{padding:0;list-style:none}.reports li{border-top:1px solid #b8afd0}.reports a{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;text-decoration:none}.reports span{white-space:nowrap;color:#52486e}@media(max-width:35rem){.reports a{display:block}.reports span{display:block;margin-top:.25rem}}</style>
