{
  "name": "sojecki-pl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prepare": "husky",
    "check": "astro check",
    "format": "oxfmt . && prettier --write 'src/**/*.astro'",
    "format:check": "oxfmt --check . && prettier --check 'src/**/*.astro'",
    "build": "npm run check && astro build",
    "test": "node --test tests/*.test.mjs",
    "test:dist": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm run test:dist"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.2",
    "astro": "7.3.3",
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.4",
    "husky": "9.1.7",
    "oxfmt": "0.70.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
