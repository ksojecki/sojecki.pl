---
import { confrontation, type Confrontation } from '../lib/reports';

const { value } = Astro.props as { value: Confrontation | null };
const level = value ? confrontation[value] : null;
---

{level ? <span class={`status-chip ${level.className}`}>{level.label}</span> : <span>n/d</span>}

<style>
  .status-chip{display:inline-flex;align-items:center;padding:.25rem .55rem;border-radius:999px;font-size:.85rem;font-weight:700;line-height:1.2}
  .stable{background:#dcfce7;color:#166534}
  .tension{background:#fef3c7;color:#92400e}
  .preparations{background:#ffedd5;color:#9a3412}
  .attack{background:#fee2e2;color:#991b1b}
</style>
