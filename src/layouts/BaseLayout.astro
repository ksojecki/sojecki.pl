---
import PageNavigation from '../components/PageNavigation.astro';
type NavigationItem = { href?: string; label: string };
const { title, description = 'Publiczna strona Kamila Sojeckiego.', navigationItems, navigationActions } = Astro.props as { title: string; description?: string; navigationItems?: NavigationItem[]; navigationActions?: NavigationItem[] };
const isRoot = Astro.url.pathname === '/';
const items = navigationItems ?? [{ href: '/', label: 'Strona główna' }, { label: title }];
const primaryNavigation = [{ href: '/blog', label: 'Blog' }, { href: '/projekty', label: 'Projekty' }, { href: '/raporty', label: 'Raporty' }];
const isCurrent = (href: string) => Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);
---
<!doctype html><html lang="pl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title} | sojecki.pl</title></head><body><header><nav class="site-navigation" aria-label="Główna nawigacja"><a class="brand" href="/" aria-current={isRoot ? 'page' : undefined}>sojecki.pl</a>{primaryNavigation.map(({ href, label }) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}</nav></header><main><slot />{!isRoot && <PageNavigation items={items} actions={navigationActions} />}</main><footer>© {new Date().getFullYear()} Kamil Sojecki</footer></body></html>
<style is:global>:root{color:#21174f;background:#f6f3fa;font-family:ui-sans-serif,system-ui,sans-serif}body{margin:0;line-height:1.6}header{border-bottom:1px solid #14e1d0;background:#21174f}nav,main,footer{box-sizing:border-box;max-width:72rem;margin:auto;padding:1rem 1.25rem}.site-navigation{display:flex;flex-wrap:wrap;gap:.2rem;align-items:center}.site-navigation a{border-radius:.4rem;color:#f5f2f7;padding:.4rem .65rem;text-decoration:none;font-size:.92rem;font-weight:600;transition:background-color .16s ease,color .16s ease}.site-navigation a:hover{background:#333;color:#14e1d0}.site-navigation a:focus-visible{outline:2px solid #14e1d0;outline-offset:2px}.site-navigation a[aria-current="page"]{background:#c433e1;color:#fff}.site-navigation .brand{margin-right:auto;padding-left:0;color:#14e1d0;font-weight:800;letter-spacing:-.02em}.site-navigation .brand[aria-current="page"]{background:transparent;color:#14e1d0}a{color:#75178a}h1,h2,h3{line-height:1.2}main{min-height:calc(100vh - 9rem)}table{display:block;max-width:100%;overflow-x:auto;border-collapse:collapse}th,td{padding:.45rem .6rem;border:1px solid #b8afd0;text-align:left;vertical-align:top}pre{overflow-x:auto;padding:1rem;background:#ede8f5}footer{background:transparent;color:#52486e;font-size:.9rem}</style>
