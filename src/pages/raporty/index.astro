---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Raporty"><section class="reports-hero"><div><p class="eyebrow">Obserwacja i analiza</p><h1>Raporty</h1><p>Publiczne, okresowe opracowania o bezpieczeństwie Polski, zagrożeniach hybrydowych i ich wpływie na region.</p><a class="report-link" href="/raporty/zagrozenia-hybrydowe">Monitoring zagrożeń hybrydowych Rosji <span aria-hidden="true">&rarr;</span></a></div><figure><img src="/images/raporty-hero-zolnierz.png" width="1672" height="941" alt="Żołnierz stojący na tle porannego krajobrazu i obserwujący horyzont" loading="eager" /><figcaption>Grafika ilustracyjna.</figcaption></figure></section></BaseLayout>
<style>.reports-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.9fr);gap:2rem;align-items:center;padding:2rem 0}.eyebrow{margin:0;color:#75178a;font-weight:700;text-transform:uppercase;font-size:.8rem;letter-spacing:.08em}.reports-hero h1{font-size:clamp(2.5rem,7vw,5rem);margin:.25rem 0}.reports-hero p:not(.eyebrow){max-width:48ch;font-size:1.08rem}.report-link{display:inline-flex;gap:.5rem;align-items:center;margin-top:.75rem;padding:.65rem .8rem;border:1px solid #75178a;text-decoration:none;font-weight:700}.reports-hero figure{margin:0}.reports-hero img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border:1px solid #b8afd0}.reports-hero figcaption{margin-top:.45rem;color:#52486e;font-size:.78rem}@media(max-width:48rem){.reports-hero{grid-template-columns:1fr}.reports-hero figure{max-width:42rem}.reports-hero img{aspect-ratio:16/9}}</style>
