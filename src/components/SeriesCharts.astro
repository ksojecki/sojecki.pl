---
type Point = { period: string; href: string; threat: number | null; intensity: number | null };
const { data } = Astro.props as { data: Record<string, Point[]> };
---
<section class="charts" aria-label="Wykresy raportów">{Object.entries(data).map(([kind, points]) => points.length > 0 && <section><h2>{{ weekly: 'Tygodniowe', monthly: 'Miesięczne', annual: 'Roczne' }[kind]}</h2><div class="grid"><figure><figcaption>Skala bezpośredniej konfrontacji (1–4)</figcaption><canvas data-chart="threat" data-kind={kind} aria-label="Skala konfrontacji: 1 Stabilnie, 2 Napięcie, 3 Przygotowania, 4 Atak"></canvas></figure><figure><figcaption>Intensywność działań</figcaption><canvas data-chart="intensity" data-kind={kind}></canvas></figure></div><p>{points.map((point) => <><a href={point.href}>{point.period}</a>{' '}</>)}</p></section>)}<p>Brak punktu oznacza <code>n/d</code>, nie wartość zero.</p><script id="chart-data" type="application/json" set:html={JSON.stringify(data)}></script></section>
<script>import Chart from 'chart.js/auto'; type Point = { period: string; threat: number | null; intensity: number | null }; const confrontationLabels = { 1: 'Stabilnie', 2: 'Napięcie', 3: 'Przygotowania', 4: 'Atak' } as const; const data = JSON.parse(document.querySelector('#chart-data')?.textContent || '{}') as Record<string, Point[]>; document.querySelectorAll<HTMLCanvasElement>('canvas[data-chart]').forEach((canvas) => { const points = data[canvas.dataset.kind ?? ''] || []; const threat = canvas.dataset.chart === 'threat'; new Chart(canvas, { type: 'line', data: { labels: points.map((point) => point.period), datasets: [{ data: points.map((point) => point[threat ? 'threat' : 'intensity']), borderColor: threat ? '#8b1ca2' : '#0d9f95', backgroundColor: threat ? '#8b1ca2' : '#0d9f95', stepped: threat, spanGaps: false }] }, options: { responsive: true, scales: { y: threat ? { min: 1, max: 4, ticks: { stepSize: 1, callback: (value) => { const score = Number(value) as keyof typeof confrontationLabels; return `${score} ${confrontationLabels[score] ?? ''}`; } } } : { min: 0, max: 10, ticks: { stepSize: 2 } } }, plugins: { legend: { display: false }, tooltip: threat ? { callbacks: { label: (context) => { const score = Number(context.parsed.y) as keyof typeof confrontationLabels; const label = confrontationLabels[score]; return label ? [label, `Poziom ${score}/4`] : 'n/d'; } } } : undefined } } }); });</script>
<style>.charts{margin-top:2rem}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}figure{margin:0;padding:1rem;border:1px solid #b8afd0}canvas{max-height:16rem}.charts a{margin-right:.5rem}@media (max-width:40rem){.grid{grid-template-columns:1fr}}</style>
