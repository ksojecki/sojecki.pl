---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { marked } from 'marked';
import { findReport, reportsByKind, type ReportKind } from '../../../../lib/reports';
const kinds = { tygodniowe: 'weekly', miesieczne: 'monthly', roczne: 'annual' } as const;
export async function getStaticPaths() {
  const paths = [];
  for (const [route, kind] of Object.entries(kinds) as [keyof typeof kinds, ReportKind][]) {
    for (const report of reportsByKind(kind)) paths.push({ params: { type: route, slug: report.id.split('/').at(-1)! } });
  }
  return paths;
}
const kind = kinds[Astro.params.type as keyof typeof kinds]; const entry = kind && findReport(kind, Astro.params.slug!); if (!entry) return new Response(null, { status: 404 });
---
<BaseLayout title={entry.title}><p><a href="/raporty/zagrozenia-hybrydowe">&larr; Monitoring zagrożeń hybrydowych Rosji</a></p><div set:html={marked.parse(entry.body)} /><p><a href="/raporty/zagrozenia-hybrydowe/metodologia">Metodologia ocen</a></p></BaseLayout>
