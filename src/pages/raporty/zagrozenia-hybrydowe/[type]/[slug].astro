---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { findReport, reportUrl, reportsByKind, type ReportKind } from '../../../../lib/reports';
import { renderMarkdown } from '../../../../lib/markdown';
export async function getStaticPaths() {
  const kinds = { tygodniowe: 'weekly', miesieczne: 'monthly', roczne: 'annual' } as const;
  const paths = [];
  for (const [route, kind] of Object.entries(kinds) as [keyof typeof kinds, ReportKind][]) {
    for (const report of reportsByKind(kind)) {
      paths.push({ params: { type: route, slug: report.slug } });
    }
  }
  return paths;
}
const kinds = { tygodniowe: 'weekly', miesieczne: 'monthly', roczne: 'annual' } as const;
const kind = kinds[Astro.params.type as keyof typeof kinds]; const entry = kind && findReport(kind, Astro.params.slug!); if (!entry) return new Response(null, { status: 404 });
const related = reportsByKind(entry.kind); const position = related.findIndex((report) => report.id === entry.id); const newer = related[position - 1]; const older = related[position + 1];
const typeLabel = { tygodniowe: 'Tygodniowe', miesieczne: 'Miesięczne', roczne: 'Roczne' }[Astro.params.type as keyof typeof kinds]!;
---
<BaseLayout title={entry.title} navigationItems={[{ href: '/', label: 'Strona główna' }, { href: '/raporty', label: 'Raporty' }, { href: `/raporty/zagrozenia-hybrydowe/${Astro.params.type}`, label: typeLabel }, { label: entry.title }]} navigationActions={[...(newer ? [{ href: reportUrl(newer), label: '← Nowszy' }] : []), ...(older ? [{ href: reportUrl(older), label: 'Starszy →' }] : [])]}><div set:html={renderMarkdown(entry.body)} /><p><a href="/raporty/zagrozenia-hybrydowe/metodologia">Metodologia ocen</a></p></BaseLayout>
