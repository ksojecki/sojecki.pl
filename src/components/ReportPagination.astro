---
import { getCollection, type CollectionEntry } from 'astro:content';
import Default from '@astrojs/starlight/components/Pagination.astro';
import type { ReportData } from '../content.config';
import { reportHref } from '../utils/reportHref';

const isReport = (
  entry: CollectionEntry<'docs'>,
): entry is CollectionEntry<'docs'> & { data: ReportData } =>
  entry.data.kind === 'report';
const currentId = Astro.locals.starlightRoute.id;
const entries = (await getCollection('docs')).filter(isReport);
const current = entries.find((entry) => entry.id === currentId);
const reports = current
  ? entries
      .filter(
        (entry) =>
          entry.data.series === current.data.series &&
          entry.data.reportType === current.data.reportType,
      )
      .sort((a, b) => a.data.period.localeCompare(b.data.period))
  : [];
const index = reports.findIndex((entry) => entry.id === currentId);
const older = index > 0 ? reports[index - 1] : undefined;
const newer = index >= 0 ? reports[index + 1] : undefined;
---

{current ? (
  <nav class="pagination-links print:hidden" aria-label="Nawigacja raportów">
    {older && (
      <a href={reportHref(older.id)} rel="prev">
        <span>
          <strong>Starszy</strong>
          <br />
          <span class="link-title">{older.data.title}</span>
        </span>
      </a>
    )}
    {newer && (
      <a href={reportHref(newer.id)} rel="next">
        <span>
          <strong>Nowszy</strong>
          <br />
          <span class="link-title">{newer.data.title}</span>
        </span>
      </a>
    )}
  </nav>
) : (
  <Default />
)}

<style>
  @layer starlight.core {
    .pagination-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
      gap: 1rem;
    }
    a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      padding: 1rem;
      text-decoration: none;
      color: var(--sl-color-gray-2);
      box-shadow: var(--sl-shadow-md);
      overflow-wrap: anywhere;
    }
    a:hover {
      border-color: var(--sl-color-gray-2);
    }
    .link-title {
      color: var(--sl-color-white);
      font-size: var(--sl-text-2xl);
      line-height: var(--sl-line-height-headings);
    }
  }
</style>
