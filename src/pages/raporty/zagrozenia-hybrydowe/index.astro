---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SeriesCharts from '../../../components/SeriesCharts.astro';
import { chartPoint, confrontationEmoji, kindLabel, reportUrl, reportsByKind } from '../../../lib/reports';
const weekly = reportsByKind('weekly'); const monthly = reportsByKind('monthly'); const annual = reportsByKind('annual');
const data = Object.fromEntries(Object.entries({ weekly, monthly, annual }).map(([kind, reports]) => [kind, reports.toReversed().map(chartPoint)]));
const latest = weekly[0] ?? monthly[0] ?? annual[0];
const comparable = latest && reportsByKind(latest.kind).find((report) => report.id < latest.id && report.intensity !== null);
const change = latest?.intensity !== null && comparable?.intensity != null ? latest.intensity - comparable.intensity : null;
const latestByKind = [{ kind: 'weekly', report: weekly[0] }, { kind: 'monthly', report: monthly[0] }, { kind: 'annual', report: annual[0] }] as const;
---
<BaseLayout title="Monitoring zagrożeń hybrydowych Rosji" navigationItems={[{ href: '/', label: 'Strona główna' }, { href: '/raporty', label: 'Raporty' }, { label: 'Monitoring zagrożeń hybrydowych Rosji' }]}>
  <section class="hero" aria-labelledby="series-title">
    <p class="eyebrow">Automatyczny raport</p><h1 id="series-title">Monitoring zagrożeń hybrydowych Rosji</h1>
    <p>Okresowe oceny udokumentowanych zagrożeń wobec Polski i NATO.</p>
    {latest && <div class="status"><div><span>Aktualna intensywność</span><strong>{latest.intensity === null ? 'n/d' : `${latest.intensity}/10`}</strong><small>{latest.title}</small></div><div><span>Zmiana wobec poprzedniego porównywalnego okresu</span><strong>{change === null ? 'n/d' : `${change > 0 ? '+' : ''}${change}`}</strong><small>{comparable ? comparable.title : 'brak danych porównawczych'}</small></div><div><span>Bezpośrednia konfrontacja Rosja–NATO</span><strong>{confrontationEmoji(latest.confrontation)}</strong><small>sygnał w najnowszym raporcie</small></div></div>}
    <div class="latest-links" aria-label="Najnowsze raporty">{latestByKind.map(({ kind, report }) => report && <a class="button" href={reportUrl(report)}>Najnowszy: {kindLabel[kind].toLowerCase()}</a>)}</div>
    <p class="actions"><a href="/raporty/zagrozenia-hybrydowe/metodologia">Metodologia ocen</a></p>
  </section>
  <SeriesCharts data={data} />
  <section class="archives" aria-label="Archiwa raportów">{([{ kind: 'weekly', reports: weekly }, { kind: 'monthly', reports: monthly }, { kind: 'annual', reports: annual }] as const).map(({ kind, reports }) => <article><h2>{kindLabel[kind]}</h2><p>{reports.length} opublikowanych raportów.</p><a href={`/raporty/zagrozenia-hybrydowe/${kind === 'weekly' ? 'tygodniowe' : kind === 'monthly' ? 'miesieczne' : 'roczne'}`}>Przejdź do listy</a></article>)}</section>
</BaseLayout>
<style>.hero{padding:1.25rem 0 .5rem}.eyebrow{margin:0;color:#75178a;font-weight:700;text-transform:uppercase;font-size:.8rem;letter-spacing:.08em}.hero h1{max-width:18ch;font-size:clamp(2.25rem,6vw,4.5rem);margin:.2rem 0}.status,.archives{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin:1.25rem 0}.status>div,.archives article{padding:1rem;border:1px solid #b8afd0;background:#fff}.status span,.status small{display:block;color:#52486e}.status strong{display:block;font-size:2rem;line-height:1.2;margin:.35rem 0}.latest-links{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}.actions{display:flex;gap:1rem;align-items:center;margin:.75rem 0}.button{display:inline-block;background:#75178a;color:#fff;padding:.55rem .75rem;text-decoration:none;font-weight:700}@media(max-width:45rem){.status,.archives{grid-template-columns:1fr}}</style>
